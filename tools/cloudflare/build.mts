/**
 * Cloudflare build: a static export of the whole site plus the files the
 * Worker (cloudflare/worker.ts) needs. Run with `npm run cf:build`.
 *
 * WHY A STATIC EXPORT AND NOT @opennextjs/cloudflare
 * --------------------------------------------------
 * Measured on 2026-10-30: the OpenNext Worker for this app is 5.9 MB gzipped
 * (minified), against the Workers FREE plan's 3 MB script limit. Every content
 * page here is already prerendered (1,743 of them), so the server runtime buys
 * nothing but size. The only truly dynamic routes are four small API handlers
 * and the embed widget; those run in a tiny Worker instead.
 *
 * Steps
 *   1. Park the route handlers that cannot be exported (app/api/**,
 *      app/embed/question/route.ts) outside app/ for the duration of the build.
 *      They are imported by the Worker directly, from their parked-and-restored
 *      original paths — nothing is copied or forked.
 *   2. `npm run build` with CF_STATIC_EXPORT=1  →  out/
 *   3. Restore the parked files (always, even on failure or Ctrl-C).
 *   4. Write out/_headers (from lib/site-routing.ts) and out/.assetsignore.
 *   5. Split any file over the 25 MiB static-asset limit into parts the Worker
 *      stitches back together (the three big free books).
 */
import { spawnSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import { match } from "path-to-regexp";
import { headerRules, redirectRules } from "../../lib/site-routing";

const ROOT = path.resolve(import.meta.dirname, "../..");
const OUT = path.join(ROOT, "out");
const STASH = path.join(ROOT, ".cf-stash");
const GEN = path.join(ROOT, "cloudflare", "generated");

// Cloudflare Workers Static Assets: 25 MiB per file (all plans).
const ASSET_LIMIT = 25 * 1024 * 1024;
const PART_SIZE = 20 * 1024 * 1024;

const PARK = ["app/api", "app/embed/question/route.ts"];

function park() {
  fs.mkdirSync(STASH, { recursive: true });
  for (const rel of PARK) {
    const from = path.join(ROOT, rel);
    const to = path.join(STASH, rel);
    if (!fs.existsSync(from)) continue;
    fs.mkdirSync(path.dirname(to), { recursive: true });
    fs.renameSync(from, to);
  }
}
function restore() {
  for (const rel of PARK) {
    const from = path.join(STASH, rel);
    const to = path.join(ROOT, rel);
    if (!fs.existsSync(from)) continue;
    fs.mkdirSync(path.dirname(to), { recursive: true });
    fs.renameSync(from, to);
  }
  fs.rmSync(STASH, { recursive: true, force: true });
}

// A previous run killed hard (SIGKILL) could leave files parked. Put them back first.
restore();
for (const sig of ["SIGINT", "SIGTERM"] as const) process.on(sig, () => { restore(); process.exit(130); });

fs.rmSync(OUT, { recursive: true, force: true });
park();
let status = 1;
try {
  const r = spawnSync("npm", ["run", "build"], {
    cwd: ROOT, stdio: "inherit",
    // npm is npm.cmd on Windows, which Node only starts through a shell; without
    // this spawnSync fails with no output and the build exits 1 silently.
    shell: process.platform === "win32",
    env: { ...process.env, CF_STATIC_EXPORT: "1", NEXT_TELEMETRY_DISABLED: "1" },
  });
  if (r.error) console.error("cf:build could not start `npm run build`:", r.error);
  status = r.status ?? 1;
} finally {
  restore();
}
if (status !== 0) process.exit(status);

// ── _headers ───────────────────────────────────────────────────────────────
// Cloudflare's _headers supports `*` splats and `:name` placeholders but not
// Next's regex groups, so `/:track(cpl|atpl)/:path*` is expanded per option.
// Rules that apply only to Worker-served paths (/embed/question) are skipped
// here; the Worker sets those itself. Same-named headers from two matching
// rules are comma-JOINED by Cloudflare, so only one rule may set any header
// for any path — true of the current list (checked below).
function expand(source: string): string[] {
  const m = source.match(/:(\w+)\(([^)]*)\)/);
  if (m) {
    const opts = m[2].split("|");
    if (opts.every(o => /^[\w.-]+$/.test(o))) {
      return opts.flatMap(o => expand(source.replace(m[0], o)));
    }
    throw new Error(`cannot express ${source} in _headers`);
  }
  return [source.replace(/:\w+\*$/, "*")];
}
const WORKER_ONLY = new Set(["/embed/question"]);
const lines: string[] = [
  "# GENERATED by tools/cloudflare/build.mts from lib/site-routing.ts — do not edit.",
  "/_next/static/*",
  "  Cache-Control: public, max-age=31536000, immutable",
];
for (const rule of await headerRules()) {
  if (WORKER_ONLY.has(rule.source)) continue;
  for (const p of expand(rule.source)) {
    lines.push(p);
    for (const h of rule.headers) lines.push(`  ${h.key}: ${h.value}`);
  }
}
// Metadata images in dynamic segments are exported as extensionless files
// (.../notes/opengraph-image); without this they would go out as octet-stream.
for (const track of ["cpl", "atpl"]) {
  lines.push(`/${track}/:subject/:chapter/:type/opengraph-image`, "  Content-Type: image/png");
}
fs.writeFileSync(path.join(OUT, "_headers"), lines.join("\n") + "\n");

// ── .assetsignore ──────────────────────────────────────────────────────────
// These files sit in public/ but are 308-redirected by redirectRules() (the
// retired chapter notes.html / slides.pdf / audio.m4a). Static assets are
// matched BEFORE the Worker runs, so if they were uploaded the redirect would
// never fire. Leaving them out sends the request to the Worker, which
// redirects exactly like Vercel did. (It also keeps 417 MB of retired audio,
// every file over the 25 MiB limit, off the CDN.)
const redirects = await redirectRules();
if (!redirects.some(r => r.source.includes("notes.html|slides.pdf|audio.m4a"))) {
  throw new Error("the /content/... notes.html|slides.pdf|audio.m4a redirect is gone; revisit .assetsignore");
}
// Any exported page whose URL is ALSO a redirect source must not be uploaded
// either: on Vercel the redirect wins (redirects run before the filesystem),
// and it must win here too.
const redirectTests = redirects.map(r => match(r.source));
const shadowed: string[] = [];
(function scan(dir: string) {
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const abs = path.join(dir, e.name);
    if (e.isDirectory()) { scan(abs); continue; }
    const rel = path.relative(OUT, abs).split(path.sep).join("/");
    if (!rel.endsWith(".html")) continue;
    const url = "/" + rel.replace(/\.html$/, "").replace(/(^|\/)index$/, "");
    if (rel.startsWith("content/")) continue; // covered by the globs below
    if (redirectTests.some(t => t(url))) shadowed.push(rel);
  }
})(OUT);
if (shadowed.length) console.log(`Not uploaded (a redirect owns the URL): ${shadowed.join(", ")}`);
fs.writeFileSync(path.join(OUT, ".assetsignore"), [
  "content/**/notes.html",
  "content/**/slides.pdf",
  "content/**/audio.m4a",
  ...shadowed,
  "",
].join("\n"));

// ── Gini's chapter text ────────────────────────────────────────────────────
// The tutor needs each chapter as plain text, and a Worker cannot read public/
// from disk. Written here, read through the ASSETS binding by cloudflare/worker.ts;
// /_gini/* is routed to the Worker first (wrangler.jsonc), which 404s it publicly.
{
  const { CPL_SUBJECTS, ATPL_SUBJECTS } = await import("../../lib/subjects");
  const { getInlineNotes } = await import("../../lib/notes-inline");
  const { chapterPlainText } = await import("../../lib/gini/tutor");
  let written = 0;
  for (const s of [...CPL_SUBJECTS, ...ATPL_SUBJECTS]) {
    for (const c of s.chapters) {
      const notes = getInlineNotes(s.id, c.id);
      const text = notes ? chapterPlainText(notes.html) : "";
      if (text.length <= 400) continue;
      const file = path.join(OUT, "_gini", "notes", s.id, `${c.id}.txt`);
      fs.mkdirSync(path.dirname(file), { recursive: true });
      fs.writeFileSync(file, text);
      written++;
    }
  }
  console.log(`Gini chapter text: ${written} chapters`);
  if (written < 200) { console.error("Gini chapter text: too few chapters written"); process.exit(1); }
}

// ── Files over the 25 MiB per-asset limit ──────────────────────────────────
const ignored = (rel: string) => /^content\/.+\/(notes\.html|slides\.pdf|audio\.m4a)$/.test(rel) || shadowed.includes(rel);
type Big = { path: string; size: number; parts: string[]; contentType: string };
const big: Big[] = [];
function walk(dir: string) {
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const abs = path.join(dir, e.name);
    if (e.isDirectory()) { walk(abs); continue; }
    const rel = path.relative(OUT, abs).split(path.sep).join("/");
    if (ignored(rel)) continue;
    const size = fs.statSync(abs).size;
    if (size <= ASSET_LIMIT) continue;
    const buf = fs.readFileSync(abs);
    const parts: string[] = [];
    for (let off = 0, i = 0; off < size; off += PART_SIZE, i++) {
      const partRel = `_parts/${rel}.part${i}`;
      fs.mkdirSync(path.dirname(path.join(OUT, partRel)), { recursive: true });
      fs.writeFileSync(path.join(OUT, partRel), buf.subarray(off, Math.min(off + PART_SIZE, size)));
      parts.push("/" + partRel);
    }
    fs.rmSync(abs);
    big.push({ path: "/" + rel, size, parts, contentType: rel.endsWith(".pdf") ? "application/pdf" : "application/octet-stream" });
  }
}
walk(OUT);
fs.mkdirSync(GEN, { recursive: true });
fs.writeFileSync(path.join(GEN, "big-files.json"), JSON.stringify({ partSize: PART_SIZE, files: big }, null, 2) + "\n");

// ── Limits report ──────────────────────────────────────────────────────────
let count = 0, total = 0, maxFile = 0;
(function count_(dir: string) {
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const abs = path.join(dir, e.name);
    if (e.isDirectory()) { count_(abs); continue; }
    const rel = path.relative(OUT, abs).split(path.sep).join("/");
    if (ignored(rel) || rel === ".assetsignore" || rel === "_headers") continue;
    const s = fs.statSync(abs).size;
    count++; total += s; maxFile = Math.max(maxFile, s);
  }
})(OUT);
console.log(`\nCloudflare static assets: ${count} files (limit 20,000), ${(total / 1048576).toFixed(0)} MiB, largest ${(maxFile / 1048576).toFixed(1)} MiB (limit 25 MiB)`);
console.log(`Split into parts: ${big.map(b => `${b.path} (${b.parts.length})`).join(", ") || "none"}`);
if (count > 20000 || maxFile > ASSET_LIMIT) { console.error("LIMIT EXCEEDED"); process.exit(1); }
