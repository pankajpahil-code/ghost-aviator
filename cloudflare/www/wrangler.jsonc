{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Redirects www.ghostaviator.com to the apex. Deploy with `npm run cf:deploy-www`.
  "name": "ghost-aviator-www",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "www.ghostaviator.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
