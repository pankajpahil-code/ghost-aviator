{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ghostaviator.com on Cloudflare Workers (free plan): a static export in
  // ./out served as Static Assets, plus a small Worker for redirects, the API
  // routes and the embed widget. Build with `npm run cf:build`; preview with
  // `npm run cf:preview`; deploy with `npm run cf:deploy`.
  "name": "ghost-aviator",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: node:crypto (Telegram webhook check) and process.env, which
  // the route handlers read their secrets from.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /about -> about.html, as `next export` expects. (/about/ and /about.html
    // never reach this: run_worker_first sends them to the Worker for a 308.)
    "html_handling": "auto-trailing-slash",
    // Unmatched paths go to the Worker (redirects, API, big files, 404).
    "not_found_handling": "none",
    // The Google verification files must answer 200 at their .html URL, which
    // html_handling would 307 away. The Worker serves them (VERBATIM_HTML).
    // "/*/" and "/*.html": html_handling answers a trailing slash or .html with
    // a 307 (temporary). The Worker answers them with a 308 (permanent) to the
    // clean URL instead (cleanUrlPath in cloudflare/worker.ts).
    "run_worker_first": ["/google03c67855fee92810.html", "/_gini/*", "/*/", "/*.html"]
  },
  "define": {
    "process.env.NODE_ENV": "\"production\""
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://ghostaviator.com"
  },
  // ghostaviator.com as a Workers Custom Domain (Cloudflare creates the DNS
  // record and certificate). The workers.dev URL stays on as a fallback.
  // www.ghostaviator.com belongs to the tiny redirect Worker in cloudflare/www/
  // (`npm run cf:deploy-www`), so www is a 301 and not a second copy of the site.
  "routes": [
    { "pattern": "ghostaviator.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
