# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# claude code workspace
.claude/

.env*.local
tools/rtr-sim/voicebank/.tmp-raw/

# YouTube metadata tooling — generated state, never committed
tools/yt/_*.json
tools/yt/_*.txt
tools/_video-chapter-map.json
__pycache__/

# Gini build intermediates — regenerate with tools/gini/*.py, never commit.
# These are ~120 MB of extracted video frames, Blender scenes and generated
# meshes. The shipped output is public/gini/sprites/*.webp only.
tools/gini/seqwork/
tools/gini/facework/
tools/gini/frames/
tools/gini/preview/
tools/gini/ref/
tools/gini/input/
tools/gini/out/
# 357 MB of extracted talking frames + cutouts for the mouth cycle.
# (gitignore has no trailing comments — a "pattern  # note" line is one literal
# pattern, which is why this note lives on its own line.)
tools/gini/talkwork/
tools/gini/*.blend
tools/gini/*.blend1

# Source material used only for verification — never served, never committed.
# Iron Rule 4: third-party books are references, not publishing sources; and a
# PDF under public/ is a public download regardless of robots.txt, which the
# scrapers hitting this site do not honour anyway.
_sources/
